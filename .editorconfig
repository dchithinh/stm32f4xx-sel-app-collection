root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp,cc,py,json,md,ini}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[**/lvgl/**]
indent_size = unset
indent_style = unset

[**/lib/fatfs/ff.c]
indent_size = unset

[**/lib/helix/**]
indent_size = unset
