{
  "name": "sdcard",
  "version": "1.0.0",
  "description": "SPI3 microSD + CS mux (stm32f407_tft_2.4inch_hat)",
  "build": {
    "includeDir": ".",
    "srcFilter": [
      "+<sd_spi.c>"
    ],
    "flags": [
      "-I $PROJECT_LIBDEPS_DIR/$PIOENV/sdcard",
      "-I $PROJECT_LIBDEPS_DIR/$PIOENV/stm32f407_hat_bsp/board"
    ]
  },
  "frameworks": "stm32cube",
  "platforms": "ststm32"
}
