{
  "name": "stm32f407_hat_bsp",
  "version": "1.0.0",
  "description": "ILI9341 + XPT2046 + LVGL port for stm32f407_tft_2.4inch_hat",
  "build": {
    "includeDir": ".",
    "srcDir": ".",
    "srcFilter": [
      "+<lcd/*.c>",
      "+<touch/*.c>",
      "+<port/*.c>",
      "+<board/bsp_sd_spi_weak.c>",
      "+<board/debug_uart.c>"
    ],
    "flags": [
      "-I $PROJECT_DIR/lib/stm32f407_hat_bsp",
      "-I $PROJECT_DIR/lib/stm32f407_hat_bsp/lcd",
      "-I $PROJECT_DIR/lib/stm32f407_hat_bsp/touch",
      "-I $PROJECT_DIR/lib/stm32f407_hat_bsp/port",
      "-I $PROJECT_DIR/lib/stm32f407_hat_bsp/board"
    ]
  },
  "frameworks": "stm32cube",
  "platforms": "ststm32"
}
