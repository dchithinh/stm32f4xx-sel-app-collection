{
  "name": "bsp",
  "version": "1.0.0",
  "description": "ILI9341 SPI LCD + XPT2046 touch + LVGL port (pomodoro BSP)",
  "build": {
    "includeDir": ".",
    "srcDir": ".",
    "srcFilter": [
      "+<lcd/*.c>",
      "+<lcd/tsc/*.c>",
      "+<lvgl/*.c>"
    ],
    "flags": [
      "-I $PROJECT_DIR/bsp",
      "-I $PROJECT_DIR/bsp/lcd",
      "-I $PROJECT_DIR/bsp/lcd/tsc",
      "-I $PROJECT_DIR/bsp/lvgl"
    ]
  }
}
